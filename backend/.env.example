# =============================================================================
# Pro Accounting — Backend
# =============================================================================
# Copie para backend/.env:
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env
#
# O arquivo .env NÃO é versionado. Nunca coloque valores reais aqui.
# Todas as variáveis são validadas na inicialização (src/config/env.ts):
# se algo estiver faltando ou inválido, o servidor não sobe e diz exatamente o quê.
# =============================================================================

# --- Aplicação --------------------------------------------------------------
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# --- Banco de dados ---------------------------------------------------------
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
# Usuário, senha, porta e nome do banco precisam bater com o .env da RAIZ
# (o que o docker-compose.yml usa para criar o container).
# Se a senha tiver caracteres especiais (@ : / ?), use percent-encoding.
DATABASE_URL="postgresql://pro_accounting:troque-esta-senha@localhost:5432/pro_accounting?schema=public"

# --- Autenticação -----------------------------------------------------------
# Mínimo de 32 caracteres. Gere um valor aleatório — não use o exemplo abaixo.
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#   Linux/macOS: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres

# Validade do token de acesso. Aceita "15m", "1h", "1d", "7d".
JWT_EXPIRES_IN=1d

# Custo do bcrypt. 12 é um bom equilíbrio entre segurança e tempo de resposta.
BCRYPT_SALT_ROUNDS=12

# --- CORS -------------------------------------------------------------------
# Origens autorizadas a chamar a API, separadas por vírgula.
# 5173 é a porta padrão do Vite em desenvolvimento.
CORS_ORIGIN=http://localhost:5173

# --- Seed do administrador --------------------------------------------------
# Usadas SOMENTE por `npm run db:seed`. A senha é gravada com hash bcrypt;
# o texto puro nunca chega ao banco.
# Troque a senha antes de rodar o seed e, em produção, troque de novo no
# primeiro login.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@proaccounting.com.br
ADMIN_PASSWORD=Admin@123456
