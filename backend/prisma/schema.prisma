// =============================================================================
// Pro Accounting — modelo de dados
// =============================================================================
// Convenções adotadas:
//
//  • Campos em camelCase no código, colunas em snake_case no banco (@map).
//    Isso mantém o TypeScript idiomático sem abrir mão de um schema SQL limpo.
//  • Ids são cuid(): ordenáveis por criação, não sequenciais e não vazam
//    volume de registros para fora (um id numérico entregaria isso).
//  • Dinheiro é SEMPRE Decimal(12,2). Float/Double causam erro de centavo e
//    não têm lugar em um sistema financeiro.
//  • Datas de calendário (vencimento, emissão) são @db.Date — sem hora e sem
//    fuso, para que "vence dia 10" não vire dia 9 às 21h em UTC-3.
//  • onDelete: Restrict no histórico financeiro. Um sistema contábil não pode
//    perder faturas porque alguém apagou um cliente.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Perfis de acesso. A tradução para pt-BR acontece na interface.
enum UserRole {
  ADMIN
  EMPLOYEE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  ACTIVE
  PENDING
  RENEWAL
  CLOSED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  PIX
  BOLETO
  TRANSFER
  CASH
  CARD
  OTHER
}

/// Ações registradas na auditoria.
///
/// A lista é fechada de propósito: um campo de texto livre viraria
/// "atualizou", "Atualizou", "update" e "UPDATE" na mesma tabela, e qualquer
/// filtro por ação passaria a mentir.
enum AuditAction {
  LOGIN
  /// Tentativa de login recusada. Registrada para que uma sequência delas
  /// contra a mesma conta seja visível.
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  ACTIVATE
  DEACTIVATE
  CANCEL
  REOPEN
  DELETE
  PAYMENT_REGISTERED
  PAYMENT_REVERSED
  ROLE_CHANGED
  PASSWORD_CHANGED
  PASSWORD_RESET
  SETTINGS_UPDATED
  EXPORT
}

/// Entidade sobre a qual a ação incidiu.
enum AuditEntity {
  SESSION
  USER
  CLIENT
  CONTRACT
  INVOICE
  PAYMENT
  SETTINGS
  REPORT
}

/// Tipo de evento registrado no histórico do cliente.
enum ClientHistoryAction {
  CREATED
  UPDATED
  ACTIVATED
  DEACTIVATED
}

/// Tipo de evento registrado no histórico da fatura.
///
/// SETTLED é separado de PAYMENT_ADDED de propósito: um pagamento parcial
/// acrescenta valor sem quitar nada, e só o lançamento que zera o saldo merece
/// a linha "fatura quitada". Sem essa distinção, três pagamentos parciais
/// produziriam três eventos idênticos e o histórico não diria em qual deles a
/// dívida acabou.
enum InvoiceHistoryAction {
  CREATED
  UPDATED
  CANCELLED
  REOPENED
  PAYMENT_ADDED
  PAYMENT_REMOVED
  SETTLED
}

/// Assunto da notificação. O texto exibido é montado no serviço, não aqui —
/// mudar a redação de um alerta não pode exigir migração de banco.
enum NotificationType {
  INVOICE_OVERDUE
  INVOICE_DUE_SOON
  CONTRACT_EXPIRING
}

/// Urgência, para ordenar a lista e escolher a cor do selo.
enum NotificationSeverity {
  CRITICAL
  WARNING
  INFO
}

// -----------------------------------------------------------------------------
// Usuários
// -----------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  name String @db.VarChar(120)

  /// Sempre gravado em minúsculas (normalizado na camada de serviço) para que
  /// a unicidade não possa ser furada por "Admin@x.com" vs "admin@x.com".
  email String @unique @db.VarChar(180)

  /// Hash bcrypt. O texto puro da senha nunca é persistido nem logado.
  password String @db.VarChar(255)

  role UserRole @default(EMPLOYEE)

  /// Desativação lógica. Usuário inativo não autentica, mas continua
  /// referenciável pelos pagamentos que registrou.
  active Boolean @default(true)

  /// Verdadeiro enquanto a senha em uso for a temporária gerada por um
  /// administrador ao resetar o acesso. É o que impede que uma senha conhecida
  /// por terceiros vire a senha definitiva da conta.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  /// Instante da última troca de senha. Tokens assinados ANTES deste instante
  /// são recusados no middleware de autenticação — é o que faz "resetar
  /// acesso" encerrar a sessão de quem já estava logado, em vez de deixá-la
  /// viva até o token expirar sozinho.
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registeredPayments Payment[]        @relation("PaymentRegisteredBy")
  clientHistory      ClientHistory[]  @relation("ClientHistoryAuthor")
  invoiceHistory     InvoiceHistory[] @relation("InvoiceHistoryAuthor")
  notifications      Notification[]
  settingsUpdates    Settings[]       @relation("SettingsUpdatedBy")
  auditLogs          AuditLog[]       @relation("AuditLogAuthor")

  @@index([role])
  @@index([active])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Auditoria
// -----------------------------------------------------------------------------

/// Trilha de auditoria do sistema — quem fez o quê, quando e de onde.
///
/// DIFERENÇA EM RELAÇÃO A `client_history` E `invoice_history`: aqueles são o
/// histórico de NEGÓCIO de um registro, exibido na ficha dele, campo a campo.
/// Este é o registro de SEGURANÇA do sistema inteiro: inclui login, logout,
/// tentativa recusada, exportação de dados e alteração de configuração — coisas
/// que não pertencem à ficha de nenhum cliente. Os dois coexistem porque
/// respondem a perguntas diferentes: "o que mudou nesta fatura" e "o que esta
/// pessoa andou fazendo no sistema".
///
/// A tabela é APPEND-ONLY. Não há rota de edição nem de exclusão, e isso é o
/// que dá algum valor a ela: uma trilha que o próprio administrador pode
/// reescrever não serve de prova de nada.
model AuditLog {
  id String @id @default(cuid())

  /// Autor. Nulo apenas quando não havia sessão — uma tentativa de login
  /// recusada, por exemplo.
  userId String? @map("user_id")

  /// CÓPIA do nome e do e-mail no instante do registro.
  ///
  /// Não é redundância com a relação acima: `userId` é `SetNull`, então excluir
  /// um usuário deixaria todas as linhas dele anônimas. Uma trilha de auditoria
  /// que perde o "quem" ao remover a conta não serve para nada — e é justamente
  /// a conta de quem fez algo errado que alguém tentaria apagar.
  userName  String? @map("user_name") @db.VarChar(120)
  userEmail String? @map("user_email") @db.VarChar(180)

  action AuditAction
  entity AuditEntity

  /// Id do registro afetado. Nulo em ações que não incidem sobre um registro
  /// (login, logout).
  entityId String? @map("entity_id")

  /// Identificação legível do registro — número da fatura, nome do cliente.
  /// Guardada porque o id sozinho não diz nada a quem lê a trilha, e o registro
  /// pode ter sido excluído depois.
  entityLabel String? @map("entity_label") @db.VarChar(180)

  /// Endereço de origem. 45 caracteres cobrem IPv6 completo.
  ip String? @db.VarChar(45)

  /// Navegador/cliente de origem, truncado. Ajuda a distinguir acesso pela
  /// interface de chamada direta à API.
  userAgent String? @map("user_agent") @db.VarChar(255)

  /// Dados relevantes da alteração: campos alterados, valor anterior e novo,
  /// motivo. JSON porque o formato varia por ação — forçar colunas fixas
  /// obrigaria a migrar a tabela a cada ação nova.
  ///
  /// NUNCA recebe senha, hash ou token. Ver `sanitizeMetadata` no serviço.
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation("AuditLogAuthor", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Serve à consulta padrão da tela: as mais recentes primeiro.
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Configurações do sistema
// -----------------------------------------------------------------------------

/// Configuração do sistema — LINHA ÚNICA.
///
/// O id é fixo (`singleton`) e o acesso é sempre por `upsert` nesse id. É o que
/// torna impossível existirem duas configurações concorrentes: sem a chave
/// fixa, uma corrida entre dois administradores salvando ao mesmo tempo criaria
/// duas linhas e o sistema passaria a ler ora uma, ora outra.
///
/// Por que uma tabela e não um arquivo `.env`: estes valores são alterados pelo
/// próprio usuário, pela interface, sem reiniciar o servidor. O `.env` continua
/// com o que é de INFRAESTRUTURA (banco, segredo do JWT) — o que muda por
/// decisão de quem opera o sistema mora aqui.
model Settings {
  /// Sempre "singleton". Ver o comentário do modelo.
  id String @id @default("singleton")

  // --- Empresa ---------------------------------------------------------------
  companyName    String  @default("Pro Accounting") @map("company_name") @db.VarChar(180)
  /// Somente dígitos, como em `clients.cpf_cnpj` — mesma razão: busca e
  /// unicidade não podem depender de máscara.
  companyCnpj    String? @map("company_cnpj") @db.VarChar(14)
  companyEmail   String? @map("company_email") @db.VarChar(180)
  companyPhone   String? @map("company_phone") @db.VarChar(11)
  companyWebsite String? @map("company_website") @db.VarChar(200)

  // Endereço desmembrado, pelo mesmo motivo do cadastro de clientes: emissão
  // fiscal exige os campos separados.
  companyZipCode      String? @map("company_zip_code") @db.VarChar(8)
  companyStreet       String? @map("company_street") @db.VarChar(180)
  companyNumber       String? @map("company_number") @db.VarChar(20)
  companyComplement   String? @map("company_complement") @db.VarChar(120)
  companyNeighborhood String? @map("company_neighborhood") @db.VarChar(120)
  companyCity         String? @map("company_city") @db.VarChar(120)
  companyState        String? @map("company_state") @db.VarChar(2)

  // --- Identidade visual -----------------------------------------------------
  /// Logotipo como data URL (`data:image/png;base64,...`).
  ///
  /// Guardado no banco, e não em arquivo, porque é UM arquivo pequeno de uma
  /// linha única: gravá-lo aqui dispensa diretório de upload, rota de arquivo
  /// estático, backup separado e limpeza de órfãos. O custo é a coluna crescer
  /// alguns KB — irrelevante para uma tabela de uma linha. Se um dia houver
  /// upload de documento por cliente, aí sim vale um storage de verdade.
  logo String? @db.Text

  /// Cores em hexadecimal `#RRGGBB`. A interface deriva delas a rampa inteira
  /// de tons; só o tom base é guardado.
  primaryColor   String @default("#2563EB") @map("primary_color") @db.VarChar(7)
  secondaryColor String @default("#0D9488") @map("secondary_color") @db.VarChar(7)

  // --- Preferências gerais ---------------------------------------------------
  /// Antecedência, em dias, para avisar que uma fatura vai vencer.
  dueSoonDays Int @default(7) @map("due_soon_days")

  currency   String @default("BRL") @db.VarChar(3)
  timeZone   String @default("America/Sao_Paulo") @map("time_zone") @db.VarChar(64)
  dateFormat String @default("dd/MM/yyyy") @map("date_format") @db.VarChar(20)

  updatedAt DateTime @updatedAt @map("updated_at")
  /// Quem salvou por último. SetNull para a configuração sobreviver à remoção
  /// do usuário que a alterou.
  updatedBy String? @map("updated_by")

  updatedByUser User? @relation("SettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Única chave estrangeira do projeto que estava sem índice. Uma tabela de
  /// uma linha não sente a diferença, mas a regra vale para todas.
  @@index([updatedBy])
  @@map("settings")
}

// -----------------------------------------------------------------------------
// Clientes
// -----------------------------------------------------------------------------

model Client {
  id String @id @default(cuid())

  /// Nome ou razão social.
  name String @db.VarChar(180)

  /// Nome fantasia (só faz sentido para pessoa jurídica).
  companyName String? @map("company_name") @db.VarChar(180)

  /// Somente dígitos: 11 para CPF, 14 para CNPJ. A máscara é responsabilidade
  /// da interface — guardar formatado quebraria a busca e a unicidade.
  cpfCnpj String @unique @map("cpf_cnpj") @db.VarChar(14)

  /// Inscrição Estadual. Texto livre porque o formato varia por UF, e
  /// "ISENTO" é um valor legítimo para quem não contribui de ICMS.
  stateRegistration String? @map("state_registration") @db.VarChar(20)

  email    String? @db.VarChar(180)
  phone    String? @db.VarChar(20)
  whatsapp String? @db.VarChar(20)

  // --- Endereço ------------------------------------------------------------
  // Desmembrado em vez de um campo único de texto livre. O motivo é prático:
  // guia de recolhimento, nota fiscal e declaração acessória exigem logradouro
  // e número em campos separados. Guardar "Rua X, 123 - Centro" numa string só
  // obrigaria a separar isso por expressão regular na hora de emitir — e
  // endereço digitado à mão nunca segue um padrão confiável.
  street       String? @db.VarChar(180)
  number       String? @db.VarChar(20)
  complement   String? @db.VarChar(120)
  neighborhood String? @db.VarChar(120)
  city         String? @db.VarChar(120)
  state        String? @db.VarChar(2)

  /// Somente dígitos (8 caracteres).
  zipCode String? @map("zip_code") @db.VarChar(8)

  status ClientStatus @default(ACTIVE)
  notes  String?      @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contracts     Contract[]
  invoices      Invoice[]
  history       ClientHistory[]
  notifications Notification[]

  @@index([status])
  @@index([name])
  @@index([email])
  @@index([createdAt])
  @@map("clients")
}

// -----------------------------------------------------------------------------
// Histórico de alterações do cliente
// -----------------------------------------------------------------------------

/// Registro de auditoria: uma linha por CAMPO alterado.
///
/// Guardar campo a campo, em vez de um retrato do registro inteiro a cada
/// edição, é o que permite a tela responder "quem mudou o telefone deste
/// cliente, e qual era o anterior" sem comparar dois JSONs grandes. O custo é
/// mais linhas; o benefício é uma consulta trivial e um histórico legível.
model ClientHistory {
  id String @id @default(cuid())

  clientId String @map("client_id")

  /// Autor da alteração. Nulo apenas se o usuário for removido do sistema —
  /// o histórico sobrevive à conta, porque é registro de auditoria.
  userId String? @map("user_id")

  action ClientHistoryAction

  /// Nome do campo alterado. Nulo em CREATED/ACTIVATED/DEACTIVATED, que são
  /// eventos do registro como um todo, não de um campo.
  field String? @db.VarChar(60)

  oldValue String? @map("old_value") @db.Text
  newValue String? @map("new_value") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User?  @relation("ClientHistoryAuthor", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Serve à consulta da aba Histórico: filtra por cliente, ordena por data.
  @@index([clientId, createdAt])
  @@index([userId])
  @@map("client_history")
}

// -----------------------------------------------------------------------------
// Contratos
// -----------------------------------------------------------------------------

model Contract {
  id String @id @default(cuid())

  clientId String @map("client_id")

  /// Número visível ao usuário, ex.: "CT-2026-0001".
  number String @unique @db.VarChar(30)

  serviceType String @map("service_type") @db.VarChar(120)

  startDate DateTime @map("start_date") @db.Date

  /// Nulo = contrato por prazo indeterminado.
  endDate DateTime? @map("end_date") @db.Date

  monthlyValue Decimal @map("monthly_value") @db.Decimal(12, 2)

  /// Dia do mês do vencimento (1 a 31). Faixa validada na API; a constraint
  /// CHECK no banco entra na Etapa 2.
  dueDay Int @map("due_day") @db.SmallInt

  status ContractStatus @default(ACTIVE)
  notes  String?        @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invoices      Invoice[]
  notifications Notification[]

  @@index([clientId])
  @@index([status])
  @@index([endDate])
  /// Serve à consulta "contratos vencendo": filtra status e ordena por término.
  @@index([status, endDate])
  /// Serve à "atividade recente" do painel e à ordenação padrão da listagem:
  /// os mais novos primeiro. Sem o índice, cada abertura do painel lia e
  /// ordenava a tabela inteira para devolver oito linhas.
  @@index([createdAt])
  @@map("contracts")
}

// -----------------------------------------------------------------------------
// Faturas
// -----------------------------------------------------------------------------

model Invoice {
  id String @id @default(cuid())

  clientId String @map("client_id")

  /// Opcional de propósito: o escritório também emite faturas avulsas, sem
  /// contrato (uma certidão, um serviço pontual).
  contractId String? @map("contract_id")

  /// Número visível ao usuário, ex.: "FAT-2026-00001".
  number String @unique @db.VarChar(30)

  description String? @db.VarChar(255)

  amount Decimal @db.Decimal(12, 2)

  issueDate DateTime @map("issue_date") @db.Date
  dueDate   DateTime @map("due_date") @db.Date

  status InvoiceStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contract Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  payments      Payment[]
  history       InvoiceHistory[]
  notifications Notification[]

  @@index([clientId])
  @@index([contractId])
  @@index([status])
  @@index([dueDate])
  /// Serve ao painel e à listagem: "pendentes vencendo/vencidas por data".
  @@index([status, dueDate])
  @@index([issueDate])
  /// Serve à "atividade recente" do painel e à ordenação padrão da listagem:
  /// os mais novos primeiro. Sem o índice, cada abertura do painel lia e
  /// ordenava a tabela inteira para devolver oito linhas.
  @@index([createdAt])
  @@map("invoices")
}

// -----------------------------------------------------------------------------
// Histórico de alterações da fatura
// -----------------------------------------------------------------------------

/// Auditoria da fatura — uma linha por evento.
///
/// Mais importante aqui do que no cliente: uma fatura é um documento de
/// cobrança. Quando o cliente questiona um valor, alguém precisa conseguir
/// responder quem alterou o quê, quando, e quem lançou cada pagamento. Guardar
/// campo a campo é o que permite responder isso sem comparar dois retratos
/// inteiros do registro.
model InvoiceHistory {
  id String @id @default(cuid())

  invoiceId String @map("invoice_id")

  /// Autor do evento. Nulo apenas se o usuário for removido do sistema — o
  /// histórico sobrevive à conta, porque é registro de auditoria.
  userId String? @map("user_id")

  action InvoiceHistoryAction

  /// Nome do campo alterado. Nulo nos eventos que são do documento como um
  /// todo (criação, cancelamento, pagamento).
  field String? @db.VarChar(60)

  oldValue String? @map("old_value") @db.Text
  newValue String? @map("new_value") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User?   @relation("InvoiceHistoryAuthor", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Serve à consulta da aba Histórico: filtra por fatura, ordena por data.
  @@index([invoiceId, createdAt])
  @@index([userId])
  @@map("invoice_history")
}

// -----------------------------------------------------------------------------
// Pagamentos
// -----------------------------------------------------------------------------

model Payment {
  id String @id @default(cuid())

  invoiceId String @map("invoice_id")

  amount Decimal @db.Decimal(12, 2)

  paymentDate   DateTime      @map("payment_date") @db.Date
  paymentMethod PaymentMethod @map("payment_method")

  /// Quem registrou o pagamento — exigência de auditoria. Por isso o usuário
  /// não pode ser excluído enquanto houver pagamentos vinculados a ele.
  registeredBy String @map("registered_by")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User    @relation("PaymentRegisteredBy", fields: [registeredBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([invoiceId])
  @@index([registeredBy])
  @@index([paymentDate])
  /// Serve à "atividade recente" do painel e à ordenação padrão da listagem:
  /// os mais novos primeiro. Sem o índice, cada abertura do painel lia e
  /// ordenava a tabela inteira para devolver oito linhas.
  @@index([createdAt])
  @@map("payments")
}

// -----------------------------------------------------------------------------
// Notificações
// -----------------------------------------------------------------------------

/// Alerta interno, persistido, com estado de leitura POR USUÁRIO.
///
/// ── Por que uma linha por usuário, e não uma linha compartilhada ────────────
///
/// "Lida" é um fato de cada pessoa. Com uma linha só para todo o escritório, o
/// funcionário que abrisse o sino marcaria o alerta como lido e o administrador
/// nunca o veria. A alternativa — uma linha compartilhada mais uma tabela de
/// leituras — economizaria registros, mas toda consulta precisaria de um JOIN e
/// a contagem de não lidas viraria um NOT EXISTS.
///
/// O custo é a multiplicação: N usuários × M condições. Num escritório contábil
/// isso são dezenas de linhas, não milhões. Em troca, marcar como lida é um
/// UPDATE simples e cada linha já tem um DESTINATÁRIO — que é exatamente o que
/// um canal de e-mail ou WhatsApp vai precisar saber para quem enviar.
///
/// ── Deduplicação ────────────────────────────────────────────────────────────
///
/// `dedupeKey` é `<tipo>:<id da entidade>:<id do usuário>` e tem índice ÚNICO.
/// É o banco que garante a ausência de duplicatas, não a lógica da varredura:
/// duas execuções simultâneas da geração não conseguem criar o mesmo alerta
/// duas vezes, porque a segunda esbarra na constraint.
model Notification {
  id String @id @default(cuid())

  /// Destinatário. Cascade: conta removida leva junto as notificações dela,
  /// que não têm valor de auditoria (o histórico das faturas tem).
  userId String @map("user_id")

  type     NotificationType
  severity NotificationSeverity

  title   String @db.VarChar(180)
  message String @db.Text

  /// Chave de deduplicação. Ver o comentário do modelo.
  dedupeKey String @unique @map("dedupe_key") @db.VarChar(160)

  /// Rota da interface que resolve o alerta (ex.: `/faturas/<id>`).
  link String? @db.VarChar(200)

  // Referências ao assunto. Todas opcionais porque tipos futuros podem não se
  // referir a nenhuma delas. SetNull em vez de Cascade: apagar a fatura não
  // deve apagar o aviso antes que a varredura o resolva naturalmente.
  invoiceId  String? @map("invoice_id")
  contractId String? @map("contract_id")
  clientId   String? @map("client_id")

  /// Nulo = não lida. Guardar o INSTANTE em vez de um booleano responde
  /// "quando esta pessoa viu isso", que um `read: true` jogaria fora.
  readAt DateTime? @map("read_at")

  /// Canais por onde a notificação já saiu. Hoje apenas `IN_APP`; e-mail,
  /// WhatsApp e push acrescentam o próprio identificador aqui, o que impede
  /// reenvio ao reexecutar a varredura.
  deliveredChannels String[] @map("delivered_channels")

  createdAt DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Serve à consulta do sino: as não lidas de um usuário, mais recentes antes.
  @@index([userId, readAt, createdAt])
  @@index([type])
  @@index([invoiceId])
  @@index([contractId])
  @@index([clientId])
  @@map("notifications")
}
