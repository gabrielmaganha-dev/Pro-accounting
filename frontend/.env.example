# =============================================================================
# Pro Accounting — Frontend
# =============================================================================
# Copie para frontend/.env:
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env
#
# ATENÇÃO: no Vite, TUDO que começa com VITE_ é embutido no JavaScript enviado
# ao navegador e fica visível para qualquer usuário. Nunca coloque segredo,
# senha ou chave de API privada em variáveis VITE_.
# =============================================================================

# Endereço base da API, incluindo o prefixo /api.
# Precisa apontar para a porta definida em backend/.env (PORT).
VITE_API_URL=http://localhost:3333/api

# Login com Google (opcional) — os mesmos valores de SUPABASE_URL e
# SUPABASE_ANON_KEY do backend. São públicos por natureza (a chave anon foi
# feita para o navegador). NUNCA coloque aqui a service role key.
# Vazias = a tela de login mostra só e-mail e senha.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
