# =============================================================================
# Pro Accounting — PRODUÇÃO
# =============================================================================
# Copie para .env.production, na raiz do projeto, e preencha:
#
#   Linux/macOS:           cp .env.production.example .env.production
#   Windows (PowerShell):  Copy-Item .env.production.example .env.production
#
# No servidor, restrinja a leitura ao dono do arquivo:
#
#   chmod 600 .env.production
#
# O .env.production NÃO é versionado (ver .gitignore) e não entra em nenhuma
# imagem Docker. Ele é lido pelo docker-compose.production.yml.
#
# A API se recusa a iniciar em produção com os valores de exemplo de JWT_SECRET
# e de senha do banco — troque os dois.
# =============================================================================

# --- Endereço público --------------------------------------------------------
# Exatamente como aparece no navegador: com https://, sem barra no final.
# É a única origem autorizada pelo CORS da API.
APP_URL=https://app.suaempresa.com.br

# Só para o perfil "https" (Caddy com certificado automático): o domínio, sem
# https://. Precisa apontar para este servidor antes da primeira subida.
DOMAIN=app.suaempresa.com.br

# Porta (ou endereço:porta) em que a interface é publicada no servidor.
#   80              sem o perfil "https": acesso direto ou atrás do SEU proxy
#   127.0.0.1:8080  com o perfil "https": só o Caddy atende a internet
APP_BIND=80

# --- Banco de dados ----------------------------------------------------------
POSTGRES_DB=pro_accounting
POSTGRES_USER=pro_accounting

# Gere com:  openssl rand -hex 32
#
# Use APENAS letras e números. A senha é montada dentro de uma URL de conexão,
# e caracteres como @ : / ? # % quebrariam a URL (a API falharia ao conectar).
#
# Ela é gravada no banco na PRIMEIRA subida. Trocar este valor depois não troca
# a senha do banco já criado — para isso use ALTER ROLE (README, seção 16.9).
POSTGRES_PASSWORD=troque-esta-senha

# Fuso do banco: horário de now() e do log do PostgreSQL.
DB_TIMEZONE=America/Sao_Paulo

# --- Autenticação ------------------------------------------------------------
# Assina os tokens de sessão. Quem tiver este valor entra como qualquer
# usuário, inclusive administrador.
#
# Gere com:  openssl rand -base64 48
# Mínimo de 32 caracteres. Trocar este valor encerra todas as sessões abertas.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres

# Validade da sessão. 8h cobre um dia de trabalho: a pessoa entra de manhã e
# o token expira à noite. Formatos aceitos: 15m, 2h, 8h, 1d.
JWT_EXPIRES_IN=8h

# Custo do hash de senha (10 a 15).
BCRYPT_SALT_ROUNDS=12

# --- Administrador inicial ---------------------------------------------------
# Usadas uma única vez, pelo comando de seed (README, seção 16.5). Em produção
# a senha é PROVISÓRIA: o sistema exige a troca no primeiro login, e recusa a
# senha de exemplo do repositório.
#
# Depois de criar o administrador, apague ADMIN_PASSWORD deste arquivo.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Login com Google (opcional) ---------------------------------------------
# Endereço e chave PÚBLICA (anon/publishable) do projeto Supabase cujo
# Authentication → Providers → Google está configurado (README, seção 17).
# As duas vão também para o navegador; NUNCA coloque aqui a service role key.
# Vazias = só login por e-mail e senha.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Operação ----------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Um backup ao subir e outro a cada N horas, em ./backups.
BACKUP_INTERVAL_HOURS=24
# Backups mais antigos que isto são apagados.
BACKUP_RETENTION_DAYS=14

# Marca das imagens construídas (pro-accounting-api:<versão>). Mudar a cada
# publicação permite voltar à imagem anterior se algo der errado.
APP_VERSION=latest

# Preencha SOMENTE se houver outro proxy na frente (balanceador, nginx do
# servidor): o endereço dele, em notação CIDR. É de quem o nginx do sistema
# aceita o cabeçalho X-Forwarded-For com o IP real do visitante.
# Ex.: 10.0.0.5/32
TRUSTED_PROXY_CIDR=127.0.0.1/32
