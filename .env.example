# =============================================================================
# Pro Accounting — variáveis do banco de dados (Docker Compose)
# =============================================================================
# Copie este arquivo para .env na RAIZ do projeto:
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env
#
# Estes valores são consumidos por docker-compose.yml.
# O arquivo .env NÃO é versionado (ver .gitignore).
# =============================================================================

# Nome do banco criado na primeira subida do container.
POSTGRES_DB=pro_accounting

# Usuário dono do banco.
POSTGRES_USER=pro_accounting

# ATENÇÃO: troque por uma senha forte antes de subir o container.
# Esta senha precisa ser a mesma usada em backend/.env -> DATABASE_URL.
POSTGRES_PASSWORD=troque-esta-senha

# Porta exposta na sua máquina.
#
# 5433 (e não 5432) de propósito: assim o container não conflita com um
# PostgreSQL instalado nativamente no Windows, que ocupa a 5432.
# Se usar o container, a DATABASE_URL em backend/.env precisa apontar para 5433.
POSTGRES_PORT=5433
